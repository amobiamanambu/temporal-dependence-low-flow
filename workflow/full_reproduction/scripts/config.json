{
  "project": {
    "name": "conus_temporal_dependence_lowflow_forecasts",
    "start_date": "1980-01-01",
    "end_date": "2025-12-31",
    "random_seed": 20260812,
    "conus_only": true
  },
  "inputs": {
    "basin_inventory": "basin_inventory.csv",
    "basin_polygons": "gridmet_data/GAGE_II_Basins.shp",
    "gage_points": "gagesII_9322_sept30_2011.shp",
    "precipitation_csv": "basin_precipitation.csv",
    "pet_csv": "basin_pet.csv",
    "discharge_directory": "usgs_dv_00060_1980_01_01_to_2025_12_31/raw_rdb_gz",
    "discharge_manifest": "usgs_dv_00060_1980_01_01_to_2025_12_31/manifest.csv",
    "discharge_qc": "quality_control/basin_quality_control_discharge_v2.csv",
    "gagesii_attributes_zip": "basinchar_and_report_sept_2011/spreadsheets-in-csv-format.zip"
  },
  "outputs": {
    "root": "continental_run",
    "database": "continental_run/data/continental_daily.sqlite"
  },
  "gridmet": {
    "base_url": "https://www.northwestknowledge.net/metdata/data",
    "variables": {
      "tmmn": "tmmn_{year}.nc",
      "tmmx": "tmmx_{year}.nc"
    },
    "years": [1980, 2025],
    "download_retries": 4,
    "download_timeout_seconds": 180,
    "chunk_days": 16,
    "minimum_valid_weight_fraction": 0.8,
    "small_basin_fallback": "all_touched",
    "minimum_center_cells_for_primary_analysis": 2
  },
  "data_qc": {
    "accepted_tiers": ["TIER1_HIGH_QUALITY", "TIER2_ACCEPTABLE_QUALITY"],
    "primary_tier": "TIER1_HIGH_QUALITY",
    "minimum_joint_days": 3650,
    "minimum_joint_fraction": 0.8,
    "maximum_negative_q_fraction": 0.0,
    "allow_negative_pet": false,
    "allow_negative_precipitation": false
  },
  "snow_proxy": {
    "snow_temperature_c": -0.4,
    "rain_temperature_c": 2.4,
    "melt_temperature_c": 0.0,
    "degree_day_factor_mm_c_day": 3.0,
    "minimum_snow_storage_mm": 1.0,
    "sensitivity_snow_temperature_c": [-1.0, -0.4, 0.0],
    "sensitivity_rain_temperature_c": [1.0, 2.4, 3.0],
    "sensitivity_degree_day_factor": [2.0, 3.0, 5.0]
  }
}
